# SOLO PARA LA DEMO DEL "ANTES" (Fase 3). NO USAR.
# Malas practicas a proposito: imagen base EOL (node:16, Debian completo),
# todas las dependencias (incluidas las de desarrollo), corre como root,
# sin HEALTHCHECK. Trivy deberia reportar muchos CVE CRITICAL/HIGH.
FROM node:16
WORKDIR /app
COPY . .
RUN npm install --ignore-scripts
EXPOSE 3000
CMD ["node", "server.js"]
