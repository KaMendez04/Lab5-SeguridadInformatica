# Copiar a .env (ignorado por git) y completar los valores. Nunca commitear .env.

# Sentry (errores y trazas). Sin SENTRY_DSN, Sentry queda apagado.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# OpenTelemetry -> Grafana Cloud (solo local). Sin endpoint, la telemetria queda apagada.
# Endpoint terminado en /otlp; header sin comillas y con %20 entre Basic y el token.
OTEL_EXPORTER_OTLP_PROTOCOL=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=
OTEL_RESOURCE_ATTRIBUTES=
